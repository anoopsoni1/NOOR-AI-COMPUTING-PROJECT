# Supported providers: ollama (local, no API key), groq (cloud), gemini (cloud)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.2
# Optional: separate vision-capable model for screenshots (defaults to LLM_MODEL)
LLM_VISION_MODEL=deepseek-ocr:3b
# Cloud API keys (strictly kept on backend, never exposed to frontend or browser). Set only the provider you use:
GROQ_API_KEY=
GEMINI_API_KEY=
# Language policy: english (always replies in English) | hinglish | hindi
RESPONSE_LANGUAGE=english
# Extra LLM judge after click/type/open steps (more accurate, costs more tokens; deterministic checks always run)
VERIFY_WITH_LLM=false

# ---- Voice ----------------------------------------------------------------------
WAKE_WORD_ENABLED=true
WAKE_PHRASE=hey noor
# Speech-to-text for your commands: auto (on-device with Ollama) | openai | openai_compatible | local_whisper
STT_PROVIDER=auto
STT_MODEL=
STT_LANGUAGE=en
# On-device model used for the wake word, interruptions and live captions (downloaded on first run).
# Use "tiny" instead of "tiny.en" for non-English wake/stop words.
LOCAL_STT_MODEL=tiny.en
STT_INTERIM=true
# Text-to-speech: edge (free neural voices, needs internet) | openai | system (offline Windows voices) | off
TTS_PROVIDER=edge
TTS_VOICE=en-US-AriaNeural
TTS_MODEL=
TTS_RATE=+0%
# Voice activity detection
VAD_ENGINE=energy
VAD_THRESHOLD=0.012
VAD_END_SILENCE_MS=900
LISTEN_TIMEOUT_S=8
CONVERSATION_WINDOW_S=20

# ---- MongoDB ------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=noor
# If MongoDB is unreachable, fall back to a temporary in-memory DB (dev only)
ALLOW_IN_MEMORY_DB=true

# ---- App URLs -----------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
# Optional shared secret required by the local API (header X-Noor-Token / ?token=)
API_TOKEN=

# ---- Agent limits (optional) --------------------------------------------------
MAX_STEPS=40
MAX_STEP_RETRIES=2
MAX_REPLANS=3
VISION_ENABLED=true

# ---- Browser / desktop (optional) ---------------------------------------------
BROWSER_HEADLESS=false
# "chrome", "msedge", or empty for Playwright's bundled Chromium
BROWSER_CHANNEL=chrome
DESKTOP_AUTOMATION_ENABLED=true

# ---- Retention (optional) -----------------------------------------------------
SCREENSHOT_RETENTION_HOURS=24
TASK_RETENTION_DAYS=90

# ---- Email tool (optional) ----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

