{
  "name": "noor-desktop",
  "version": "1.0.0",
  "description": "NOOR — AI Computer Operator",
  "main": "dist/electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"npm run electron:dev\"",
    "electron:dev": "tsc -p electron/tsconfig.json && wait-on tcp:5173 && cross-env NOOR_DEV=1 electron .",
    "build": "tsc -p electron/tsconfig.json && tsc -p frontend/tsconfig.json --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.noor.operator",
    "productName": "NOOR",
    "directories": { "output": "release" },
    "files": ["dist/**/*"],
    "extraResources": [{ "from": "../backend", "to": "backend", "filter": ["**/*", "!tests/**", "!__pycache__/**"] }],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
